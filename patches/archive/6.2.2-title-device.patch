+/** 원본 게시글의 작성 기기 아이콘. 확인된 방법대로 사이트 CSS를 읽어 Shadow DOM에 복사한다. */
+const DeviceIcon = ({html}: { html: string }) => {
+    const target = useRef<HTMLSpanElement>(null);
+
+    useLayoutEffect(() => {
+        const source = new DOMParser().parseFromString(html, "text/html").querySelector<HTMLElement>(".title_device");
+        if (!source || !target.current) return;
+
+        const probe = document.createElement("div");
+        probe.className = "gallview_head";
+        probe.style.cssText = "position:fixed!important;left:-10000px!important;opacity:0!important";
+        const heading = document.createElement("h3");
+        heading.className = "title ub-word";
+        heading.append(source);
+        probe.append(heading);
+        document.body.append(probe);
+
+        const clone = source.cloneNode(true) as HTMLElement;
+        const originals = [source, ...source.querySelectorAll<HTMLElement>("*")];
+        const copies = [clone, ...clone.querySelectorAll<HTMLElement>("*")];
+        originals.forEach((element, i) => {
+            const css = getComputedStyle(element);
+            for (let j = 0; j < css.length; j++) {
+                const name = css[j];
+                copies[i].style.setProperty(name, css.getPropertyValue(name));
+            }
+        });
+        probe.remove();
+
+        target.current.append(clone);
+        return () => clone.remove();
+    }, [html]);
+
+    return <span ref={target}/>;
+};
